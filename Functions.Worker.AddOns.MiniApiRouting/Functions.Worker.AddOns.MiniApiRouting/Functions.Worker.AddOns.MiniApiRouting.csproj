<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Functions.Worker.AddOns.MiniApiRouting</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>BBernard / CajunCoding</Authors>
    <Company>CajunCoding</Company>
    <Description>Compile-time generated Mini APIs for Azure Functions isolated worker -- One Function many routes!.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cajuncoding/AzureFunctions.IsolatedProcess.AddOns</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cajuncoding/AzureFunctions.IsolatedProcess.AddOns</RepositoryUrl>
    <PackageTags>Azure, Functions, Worker, Isolated, MiniApi, MinimalApi, Routing, SourceGenerator, One, Single, Function, Many, Multiple, API, Routes</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="../Functions.Worker.AddOns.MiniApiRouting.Generators/Functions.Worker.AddOns.MiniApiRouting.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Link="README.md" Pack="true" PackagePath="/" />
    <None Include="../Functions.Worker.AddOns.MiniApiRouting.Generators/bin/$(Configuration)/netstandard2.0/Functions.Worker.AddOns.MiniApiRouting.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Design-Decisions.md" Link="Design-Decisions.md" />
    <None Include="..\Diagnostics.md" Link="Diagnostics.md" />
  </ItemGroup>
</Project>
